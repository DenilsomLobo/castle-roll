# Configure these variables in the hosting dashboard (this file is not loaded automatically).
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_ORIGIN=https://seu-dominio.example
RANKING_MODE=online
# Must point to a persistent, writable volume, outside publicly served files.
DATA_FILE=/app/data/ranking.json
# Optional: exact IP addresses of trusted reverse proxies; never use a wildcard.
TRUSTED_PROXIES=
